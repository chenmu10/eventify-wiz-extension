# Environment variables for the application

# Google Extension Key (if applicable, otherwise remove or leave blank)
GOOGLE_EXTENSION_KEY=YOUR_GOOGLE_EXTENSION_KEY_HERE_OR_REMOVE

# Google Client ID for OAuth (if applicable, otherwise remove or leave blank)
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE_OR_REMOVE

# Gemini API Key
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_PLACEHOLDER_HERE

# Commented out OpenAI variables (if they were previously used)
# OPENAI_URL=YOUR_OPENAI_URL_HERE
# OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
